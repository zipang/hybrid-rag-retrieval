# Qdrant (bare-metal binary started from ./qdrant/qdrant)
QDRANT_URL=http://127.0.0.1:6333
# The collection name comes from the dataset schema in src/config/datasets.ts.
#
# When QDRANT_URL uses HTTPS with a private CA (for example the SKYLAB host
# https://qdrant.skylab.local), point Bun at that CA so it can verify the
# certificate. Do NOT disable TLS verification: a global
# NODE_TLS_REJECT_UNAUTHORIZED=0 turns it off for every HTTPS call, including
# the LLM provider. For a local-only unblock, put that flag in .env.local.
#NODE_EXTRA_CA_CERTS=/path/to/skylab-local-ca.pem

# Embeddings: local (default, fastembed dense) or cloud provider name
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_API_KEY=
# Dense model max token length. FastEmbed pads every text to this width, so a
# value near the corpus maximum saves most of the compute. The slogan corpus
# max is 27 tokens (236 records), so 32 keeps every token.
EMBEDDING_MAX_LENGTH=32

# Qdrant native BM25 sparse inference (keyword side of the hybrid search).
# These options must be identical at ingest and query time.
BM25_LANGUAGE=french
BM25_ASCII_FOLDING=true
# Average slogan length in tokens (BM25 avg_len; default is 256, wrong for short slogans).
# Corpus average is ~6.91 words, so 7 is a sensible default.
BM25_AVG_LEN=7

# French dependency parser (UDPipe/WASM). The model is downloaded by
# `bun run init` into ./models. This path must point at that file.
UDPIPE_MODEL_PATH=models/french-gsd-ud-2.5-191206.udpipe

# LLM provider (OpenAI-compatible endpoint: OpenAI, Mistral, Ollama, ...)
# Uncomment one base URL. The app calls the OpenAI-compatible `/chat/completions`
# route, so keep the base URL without that suffix.
# OpenCode Go (https://opencode.ai/docs/go/), key from https://opencode.ai/auth
#AI_PROVIDER_URL=https://opencode.ai/zen/go/v1
# OpenAI
#AI_PROVIDER_URL=https://api.openai.com/v1
# Mistral
#AI_PROVIDER_URL=https://api.mistral.ai/v1
# Ollama (local)
#AI_PROVIDER_URL=http://127.0.0.1:11434/v1
# OpenRouter
#AI_PROVIDER_URL=https://openrouter.ai/api/v1
# Groq
#AI_PROVIDER_URL=https://api.groq.com/openai/v1
# Together AI
#AI_PROVIDER_URL=https://api.together.xyz/v1
AI_PROVIDER_URL=https://api.openai.com/v1
AI_API_KEY=
# Model id must exist on the chosen endpoint. The list for OpenCode Go is
# `curl https://opencode.ai/zen/go/v1/models`.
# OpenCode Go: deepseek-v4.1-flash, kimi-k3, glm-5.3, mimo-v2.6-pro, hy3
AI_MODEL=gpt-4o-mini

# Conversational retrieval agent: maximum number of generation steps. The agent
# searches, reads the records, and may search again inside this budget. Integer
# of at least 1.
AGENT_MAX_STEPS=6
# Directory of agent resources. One agent is one Markdown file with a YAML
# frontmatter; the id is the file name without `.md`.
AGENTS_DIR=agents
# Agent id used when a chat request names none.
AGENT_ID=default

# Server
PORT=3000
