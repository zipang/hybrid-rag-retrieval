{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.json",
			"**/*.jsonc",
			"**/*.html",
			"**/*.css",
			"!**/qdrant",
			"!**/local_cache",
			"!**/node_modules",
			"!**/.opencode",
			"!**/.agents",
			"!**/.tmp",
			"!**/references"
		],
		"ignoreUnknown": true
	},
	"formatter": {
		// `bun fmt` is the only writer. Its whitespace rules come from
		// `.editorconfig` and its remaining options from `bunfig.toml`. Biome
		// keeps the lint rules only, so the two tools never fight over line
		// breaking. See AGENTS.md, "Formatting and linting".
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"json": {
		"parser": {
			"allowComments": true
		}
	}
}
